{
  "cleanUrls": false,
  "directoryListing": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "media/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
    { "source": "assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
  ]
}
